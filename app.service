[Unit]
Description=Local Dashboard Service
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/mfc-monitor-isolated/webserver/app.py
WorkingDirectory=/home/pi/mfc-monitor-isolated/webserver
Restart=always
RestartSec=30
User=pi
Environment=DISPLAY=:0

[Install]
WantedBy=multi-user.target
